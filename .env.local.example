# Database (Neon PostgreSQL - serverless)
# Sign up at https://neon.tech and create a project.
# Use the pooled connection string from your Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/applyx?sslmode=require

# AI
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key_as_fallback
XAI_API_KEY=your_grok_api_key_as_emergency_fallback
DEVELOPER_ADMIN_EMAILS=founder@example.com

# Dodo Payments
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_key
DODO_ENVIRONMENT=test_mode
DODO_BASIC_PRODUCT_ID=prod_basic_monthly
DODO_PREMIUM_PRODUCT_ID=prod_premium_monthly

# Manual billing fallback
MANUAL_UPI_ID=
MANUAL_UPI_NAME=
MANUAL_UPI_PAYMENT_URL=
MANUAL_INTERNATIONAL_PAYMENT_URL=
MANUAL_BILLING_SUPPORT_EMAIL=
MANUAL_BILLING_SUPPORT_WHATSAPP=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage (S3-compatible, like Cloudflare R2)
S3_ENDPOINT=your_s3_compatible_endpoint
S3_REGION=auto
S3_BUCKET=applyx-resumes
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret
