# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/applyx

# Auth
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key_as_fallback

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage
S3_ENDPOINT=your_s3_compatible_endpoint
S3_REGION=auto
S3_BUCKET=applyx-resumes
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret
